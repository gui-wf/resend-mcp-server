# Resend MCP Server - Environment Configuration
# Copy this file to .env and fill in your values.
#
# IMPORTANT: Never commit your actual .env file to version control!

# =============================================================================
# Required Configuration
# =============================================================================

# Resend API Key (required)
# Get your API key from: https://resend.com/api-keys
# Must start with "re_"
RESEND_API_KEY=re_your_api_key_here

# =============================================================================
# Optional Configuration
# =============================================================================

# Enabled tool scopes (optional)
# Comma-separated list of: read, write, admin
# If not set, all scopes are enabled
# Examples:
#   RESEND_MCP_SCOPES=read          # Read-only access
#   RESEND_MCP_SCOPES=read,write    # Read and write, no admin
#   (not set)                        # All scopes enabled
# RESEND_MCP_SCOPES=read,write,admin

# Default tool tier to load on startup (optional)
# Options: core, secondary, tertiary, all
#   core      - Essential tools only (send_email, list_domains, get_email, docs)
#   secondary - Core + additional tools (batch_send, create_domain, etc.)
#   tertiary  - All available tools (contacts, audiences, api_keys)
#   all       - Alias for tertiary
# Default: core
# RESEND_MCP_DEFAULT_TIER=core

# Rate limit interval in milliseconds (optional)
# Minimum time between API calls to avoid rate limiting
# Resend free tier: 2 requests/second (500ms minimum)
# Resend pro tier: 10 requests/second (100ms minimum)
# Default: 500
# RESEND_RATE_LIMIT_MS=500

# Enable debug logging (optional)
# Set to "true", "1", or "yes" to enable verbose logging
# Default: false
# RESEND_DEBUG=false
