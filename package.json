{
  "name": "mcp-resend",
  "version": "1.0.0-5",
  "description": "Comprehensive MCP Server for Resend API - manage emails, domains, templates, contacts, and more via AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "resend-mcp-server": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "data/embeddings.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "build:embeddings": "tsx scripts/build-embeddings.ts",
    "build:embeddings:force": "tsx scripts/build-embeddings.ts --force",
    "prepublishOnly": "npm run typecheck && npm run test:run && npm run build"
  },
  "keywords": [
    "mcp",
    "resend",
    "email",
    "claude",
    "typescript",
    "model-context-protocol",
    "ai-assistant",
    "email-api"
  ],
  "author": "gui-wf",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gui-wf/resend-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/gui-wf/resend-mcp-server/issues"
  },
  "homepage": "https://github.com/gui-wf/resend-mcp-server#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@xenova/transformers": "^2.17.0",
    "resend": "^6.8.0",
    "zod": "^3.23.0",
    "zod-validation-error": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.1.0",
    "msw": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
